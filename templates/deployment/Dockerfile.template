# App-Specific Dockerfile Template
# This file should be customized for each application
# Replace {{APP_NAME}} with your actual app name

FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_ENABLE_CORS=false \
    STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false \
    STREAMLIT_SERVER_HEADLESS=true \
    APP_NAME={{APP_NAME}}

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app user for security
RUN useradd --create-home --shell /bin/bash {{APP_NAME}}_user

# Set working directory
WORKDIR /app

# Copy requirements first for better Docker layer caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories with proper permissions
RUN mkdir -p /app/.streamlit /app/temp /app/logs && \
    chown -R {{APP_NAME}}_user:{{APP_NAME}}_user /app

# Create Streamlit configuration
RUN echo '[server]' > /app/.streamlit/config.toml && \
    echo 'port = 8501' >> /app/.streamlit/config.toml && \
    echo 'address = "0.0.0.0"' >> /app/.streamlit/config.toml && \
    echo 'headless = true' >> /app/.streamlit/config.toml && \
    echo 'enableCORS = false' >> /app/.streamlit/config.toml && \
    echo 'enableXsrfProtection = false' >> /app/.streamlit/config.toml && \
    echo 'maxUploadSize = 200' >> /app/.streamlit/config.toml && \
    echo '[theme]' >> /app/.streamlit/config.toml && \
    echo 'primaryColor = "#FF6B6B"' >> /app/.streamlit/config.toml && \
    echo 'backgroundColor = "#FFFFFF"' >> /app/.streamlit/config.toml && \
    echo 'secondaryBackgroundColor = "#F0F2F6"' >> /app/.streamlit/config.toml

# Switch to app user
USER {{APP_NAME}}_user

# Create app-specific environment file
RUN echo "APP_NAME={{APP_NAME}}" > /app/.env && \
    echo "ENVIRONMENT=production" >> /app/.env && \
    echo "LOG_LEVEL=INFO" >> /app/.env

# Expose the application port
EXPOSE 8501

# Health check specific to this app
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run the application
CMD ["streamlit", "run", "app.py", "--server.runOnSave", "false", "--server.fileWatcherType", "none"]