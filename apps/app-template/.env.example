# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your-account.region.cloud
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password  # Optional if using private key
SNOWFLAKE_DATABASE=YOUR_APP_DB
SNOWFLAKE_SCHEMA=AI_APPS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Authentication (choose ONE; private key recommended for production)
# 1) Private Key Authentication
# SNOWFLAKE_PRIVATE_KEY_PATH=/app/.streamlit/keys/private_key.pem
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your-passphrase
#
# 2) Inline Private Key (CI only)
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----\n"
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your-passphrase
#
# 3) Password Auth (development only)
# SNOWFLAKE_PASSWORD=your-password

# Application Specific
APP_NAME=your-app-name
CORTEX_MODEL=mistral-large  # Options: mistral-large, llama2-70b-chat, reka-flash, mixtral-8x7b

# Optional: AI Model Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000